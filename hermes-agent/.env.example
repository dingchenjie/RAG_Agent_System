# ============================================================
# 模式 A：无 Key（默认）—— Mock 模型 + 哈希向量，离线可跑、结果可复现
# 不设置任何变量即可，本文件只是清单，项目不会自动读取 .env
# ============================================================
HERMES_LLM_PROVIDER=mock
HERMES_EMBEDDING=hashing
HERMES_RERANK=rrf

# ============================================================
# 模式 B：有 Key（真实模型）—— 下面三项改掉即可
# ============================================================
# HERMES_LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=
# HERMES_EMBEDDING=zhipu          # 显式指定：失败直接报错，不静默降级
# 换 embedding 后端后必须重建索引：删除 HERMES_DB_PATH 指向的 db 文件

# ============================================================
# 通用配置（两种模式都适用）
# ============================================================
HERMES_LLM_MODEL=glm-4-air
HERMES_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

HERMES_DB_PATH=data/hermes.db
HERMES_MAX_STEPS=12
HERMES_LLM_TIMEOUT_S=60
HERMES_TOOL_TIMEOUT_S=15
HERMES_CONTEXT_TOKENS=4096
HERMES_MAX_CONCURRENCY=4

# 知识层：auto = 显式配置 > 本地 semantic 模型 > 智谱 Key > 哈希
HERMES_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HERMES_EMBEDDING_DIM=384
HERMES_RERANK_MODEL=BAAI/bge-reranker-base
HERMES_DEDUPE_THRESHOLD=0.92
HERMES_FAITHFULNESS_MIN_SUPPORT=0.6
HERMES_UPLOAD_DIR=data/uploads

# MCP：自建 server 的启动命令（Python 单栈，stdio 传输）
HERMES_MCP_COMMAND=python
HERMES_MCP_ARGS=-m,hermes.mcp_server.server

# ============================================================
# 安全 / 多租户
# ============================================================
# off：单租户管理员（默认，仅本地/演示/CI）；api_key：必须带凭证
HERMES_AUTH_MODE=off
# 格式：key:tenant:user:scope1|scope2;key2:tenant2:user2:scope3
# 管理员用 * 租户 + * scope（只能降权，不能升权）
# HERMES_API_KEYS=devkey:acme:alice:tool:read|knowledge:read|knowledge:write
HERMES_MAX_UPLOAD_MB=20

# ============================================================
# 主动触发（interval 触发器）
# ============================================================
# 后台扫描周期（秒）；<=0 关闭后台循环（测试/CI 用）
HERMES_TRIGGER_TICK_S=10
