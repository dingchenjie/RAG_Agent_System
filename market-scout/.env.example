# 模型：mock=离线确定性；openai=任何 OpenAI 兼容网关
SCOUT_LLM_PROVIDER=mock
SCOUT_LLM_BASE_URL=https://api.agicto.cn/v1
SCOUT_LLM_MODEL=gpt-4o-mini
SCOUT_LLM_API_KEY=

# 预算与护栏
SCOUT_MAX_STEPS=10
SCOUT_MAX_PAGES=8
SCOUT_MAX_RUN_COST_USD=0.05
SCOUT_TOOL_TIMEOUT_S=20
SCOUT_MAX_SECTIONS=3

# 浏览器
SCOUT_BROWSER_HEADLESS=true
SCOUT_BROWSER_ALLOW_DOMAINS=
SCOUT_BROWSER_TIMEOUT_MS=25000

# 提示词版本（v1 | v2），评测里做 A/B
SCOUT_PROMPT_VERSION=v2

# Langfuse 自托管（不填则只写本地 JSONL，不影响运行）
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-market-scout
LANGFUSE_SECRET_KEY=sk-lf-market-scout

# HTTP
SCOUT_API_HOST=127.0.0.1
SCOUT_API_PORT=8099
